OPENAI_API_KEY=
TAVILY_API_KEY=
# optional: higher rate limits on the Jina page reader
JINA_API_KEY=
DATABASE_URL=postgres://hive:hive@localhost:5432/hive
# optional model overrides (default: gpt-6-luna for both)
HIVE_LEAD_MODEL=
HIVE_WORKER_MODEL=
# optional: agents running at once (default 3); raise if your OpenAI rate limit allows
HIVE_MAX_CONCURRENCY=
# optional: web searches (Tavily credits) each agent may make (default 4)
HIVE_MAX_SEARCHES_PER_AGENT=
# optional "user:pass"; enables basic auth middleware
HIVE_BASIC_AUTH=
